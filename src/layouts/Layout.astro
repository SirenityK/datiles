---
import "@fontsource-variable/inter/wght.css";
import "@fontsource-variable/playfair-display/wght.css";
import ClientRouter from "astro/components/ClientRouter.astro";
import { GOOGLE_ANALYTICS_ID } from "astro:env/client";
import Footer from "../components/Footer.astro";
import Header from "../components/Header.astro";
import { description } from "../logic";
import "../styles/global.css";

const GTagScript = `function a(){dataLayer.push(arguments)}window.dataLayer=window.dataLayer||[],a("js",new Date),a("config","${GOOGLE_ANALYTICS_ID}");`;
---

<!doctype html>
<html lang="es">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width" />
    <link rel="icon" type="image/svg+xml" href="/favicon.svg" />
    <meta name="description" content={description} />
    <meta name="generator" content={Astro.generator} />
    <title>Higo | Dona higos</title>

    <ClientRouter />
    <script
      type="text/partytown"
      src=`https://www.googletagmanager.com/gtag/js?id=${GOOGLE_ANALYTICS_ID}`
    ></script>
    <script type="text/partytown" set:html={GTagScript} />
  </head>
  <body>
    <div class="min-h-screen">
      <Header />
      <slot />
    </div>
    <Footer />
  </body>
</html>
