---
import { PageRefs } from "../logic";
import Leaf from "lucide-astro/Leaf";

const links = [
  { href: PageRefs.informationHash, text: "Información" },
  { href: PageRefs.reasonsHash, text: "Razones" },
  { href: PageRefs.joinUsHash, text: "Contribuir" },
  { href: PageRefs.contact, text: "Contacto" },
];
---

<nav class="flex w-full flex-wrap items-center gap-3 bg-primary p-4 text-white">
  <a
    class="flex shrink-0 gap-1 max-sm:mx-auto"
    href="/"
    aria-label="Ir al inicio de NODESS"
  >
    <Leaf />
    <span class="font-bold">NODESS</span>
  </a>
  <div
    class="flex w-full flex-wrap justify-center gap-1 sm:ml-auto sm:w-auto sm:justify-end"
  >
    {
      links.map((link) => (
        <a
          class="rounded-md px-3 py-2 text-sm transition hover:bg-primary-focus focus-visible:ring-2 focus-visible:ring-white focus-visible:outline-none sm:px-4"
          href={link.href}
        >
          {link.text}
        </a>
      ))
    }
  </div>
</nav>
