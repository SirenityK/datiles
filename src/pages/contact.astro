---
import Layout from "../layouts/Layout.astro";
import Card from "../components/Card.astro";
import Building2 from "lucide-astro/Building2";
import BriefcaseBusiness from "lucide-astro/BriefcaseBusiness";
import ExternalLink from "lucide-astro/ExternalLink";
import Mail from "lucide-astro/Mail";
import Phone from "lucide-astro/Phone";
import { Palette } from "../logic";

const contact = {
  institution: "Instituto Tecnológico de Mexicali",
  area: "Gestión y vinculación",
  phone: "6865804900",
  email: "gestion@itmexicali.edu.mx",
} as const;

const formattedPhone = "686 580 4900";

const nodessContact = {
  name: "Karina López Valle",
  phone: "6866090398",
  email: "karinalopezvalle@gmail.com",
} as const;

const formattedNodessPhone = "686 609 0398";
---

<Layout>
  <div class="mx-4 my-12 flex flex-col items-center gap-6 md:my-20">
    <Card>
      <div
        class="overflow-hidden rounded-2xl bg-white shadow-xl ring-1 shadow-primary/10 ring-primary/10"
      >
        <div class="h-2 bg-linear-to-r from-primary via-fig-rose to-fig-sage">
        </div>
        <div class="grid gap-8 p-6 md:grid-cols-[1fr_auto] md:p-10">
          <div class="space-y-6">
            <div class="space-y-3">
              <p
                class="w-fit rounded-full bg-fig-mist px-3 py-1 text-sm font-semibold tracking-wide text-primary uppercase"
              >
                Contacto institucional
              </p>
              <h1
                class="font-playfair text-4xl leading-tight font-bold text-primary md:text-5xl"
              >
                Coordinémonos
              </h1>
              <p class="max-w-2xl text-lg text-primary/80">
                Escríbenos para resolver dudas, confirmar disponibilidad y
                coordinar la entrega de higos con el equipo indicado.
              </p>
            </div>

            <div class="grid gap-3">
              <div class="flex items-start gap-3 rounded-xl bg-fig-cream p-4">
                <Building2 class="mt-1 shrink-0" color={Palette.red} />
                <div>
                  <p class="text-sm font-bold text-primary/80">Institución</p>
                  <p class="text-lg font-semibold text-primary">
                    {contact.institution}
                  </p>
                </div>
              </div>

              <div class="flex items-start gap-3 rounded-xl bg-fig-mist p-4">
                <BriefcaseBusiness
                  class="mt-1 shrink-0"
                  color={Palette.green}
                />
                <div>
                  <p class="text-sm font-bold text-primary/80">Área</p>
                  <p class="text-lg font-semibold text-primary">
                    {contact.area}
                  </p>
                </div>
              </div>
            </div>
          </div>

          <aside
            class="grid content-center gap-3 rounded-2xl bg-primary p-5 text-white md:min-w-80"
          >
            <div
              class="mb-2 flex h-12 w-12 items-center justify-center rounded-full bg-white/15"
            >
              <Mail />
            </div>
            <p class="font-playfair text-3xl font-bold">Hablemos</p>
            <p class="text-sm text-white/75">
              Usa el medio que prefieras. Ambos enlaces están listos para abrir
              correo o llamada directamente.
            </p>

            <a
              href={`mailto:${contact.email}`}
              class="mt-3 flex items-center justify-between gap-3 rounded-xl bg-white px-4 py-3 font-semibold text-primary transition hover:bg-fig-cream"
            >
              <span>{contact.email}</span>
              <ExternalLink class="shrink-0" size="18" />
            </a>

            <a
              href={`tel:+52${contact.phone}`}
              class="flex items-center justify-between gap-3 rounded-xl border border-white/20 px-4 py-3 font-semibold text-white transition hover:bg-white/10"
            >
              <span>{formattedPhone}</span>
              <Phone class="shrink-0" size="18" />
            </a>
          </aside>
        </div>
      </div>
    </Card>

    <Card>
      <section
        class="overflow-hidden rounded-2xl bg-primary text-white shadow-xl shadow-primary/10"
        aria-labelledby="nodess-contact-title"
      >
        <div class="h-2 bg-linear-to-r from-fig-rose via-fig-sage to-fig-wood">
        </div>
        <div class="p-6 md:p-10">
          <p
            class="w-fit rounded-full bg-white/15 px-3 py-1 text-sm font-semibold tracking-wide text-fig-cream uppercase"
          >
            Contacto del NODESS Higos de la Flor
          </p>
          <h2
            id="nodess-contact-title"
            class="mt-4 font-playfair text-4xl leading-tight font-bold md:text-5xl"
          >
            {nodessContact.name}
          </h2>
          <div class="mt-8 grid gap-3 sm:grid-cols-2">
            <a
              href={`mailto:${nodessContact.email}`}
              class="flex min-w-0 items-center justify-between gap-3 rounded-xl bg-white px-4 py-3 font-semibold text-primary transition hover:bg-fig-cream focus-visible:ring-2 focus-visible:ring-white focus-visible:outline-none"
            >
              <span class="break-all">{nodessContact.email}</span>
              <ExternalLink class="shrink-0" size="18" />
            </a>
            <a
              href={`tel:+52${nodessContact.phone}`}
              class="flex items-center justify-between gap-3 rounded-xl border border-white/20 px-4 py-3 font-semibold text-white transition hover:bg-white/10 focus-visible:ring-2 focus-visible:ring-white focus-visible:outline-none"
            >
              <span>{formattedNodessPhone}</span>
              <Phone class="shrink-0" size="18" />
            </a>
          </div>
        </div>
      </section>
    </Card>
  </div>
</Layout>
